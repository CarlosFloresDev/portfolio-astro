---
import Layout from "../layouts/Layout.astro";
import { perfil, experiencia, proyectos, habilidades, educacion } from "../data/perfil";

const destacados = proyectos.filter((p) => p.destacado);
const otros = proyectos.filter((p) => !p.destacado);
const anio = new Date().getFullYear();
---

<Layout
  title={`${perfil.nombre} · ${perfil.rol}`}
  description={`${perfil.rol} en ${perfil.ubicacion}. Backend .NET y Java, apps móviles con Flutter, web con React y Astro, y videojuegos.`}
>
  <header class="barra">
    <a href="#inicio" class="marca"><span class="marca-sig">CL</span>{perfil.nombre}</a>
    <nav>
      <a href="#sobre-mi">Sobre mí</a>
      <a href="#experiencia">Experiencia</a>
      <a href="#proyectos">Proyectos</a>
      <a href="#habilidades">Habilidades</a>
      <a href="#contacto" class="nav-cta">Contacto</a>
    </nav>
  </header>

  <main>
    <section id="inicio" class="hero contenedor">
      <p class="etiqueta aparece"><span class="punto"></span>Disponible para trabajar · {perfil.ubicacion}</p>
      <h1 class="aparece">
        Hola, soy <span class="degradado">{perfil.nombre}</span>.<br />
        Construyo software de punta a punta.
      </h1>
      <p class="hero-rol aparece">
        <span class="mono">&gt;</span>
        <span data-roles={JSON.stringify(perfil.roles)}>{perfil.roles[0]}</span><span class="cursor"></span>
      </p>
      <p class="hero-texto aparece">{perfil.resumen}</p>
      <div class="acciones aparece">
        <a class="boton boton-principal" href="#proyectos">Ver proyectos</a>
        <a class="boton" href={perfil.github} target="_blank" rel="noopener">GitHub</a>
        <a class="boton" href={`mailto:${perfil.email}`}>Escríbeme</a>
      </div>
      <dl class="cifras aparece">
        <div><dt>Sitios en producción</dt><dd>4</dd></div>
        <div><dt>Mods de Minecraft</dt><dd>6</dd></div>
        <div><dt>Lenguajes</dt><dd>10</dd></div>
      </dl>
    </section>

    <section id="sobre-mi" class="contenedor seccion">
      <h2 class="titulo aparece"><span class="mono">01.</span> Sobre mí</h2>
      <div class="sobre aparece">
        <p>
          Soy desarrollador full stack y estudiante de <strong>Diseño y Desarrollo de Software en TECSUP</strong>. Me
          gusta tomar una idea y llevarla hasta producción: diseño la interfaz, construyo la API, modelo la base de
          datos, armo la app y la despliego con integración continua.
        </p>
        <p>
          Mi formación previa en electrónica me llevó a proyectos donde el software toca el mundo físico, como un
          guante háptico con ESP32 para un videojuego accesible. Fuera de clase hago videojuegos, mods y sitios para
          negocios reales.
        </p>
        <ul class="educacion">
          {educacion.map((e) => (
            <li><strong>{e.titulo}</strong><span>{e.lugar}</span><span class="mono">{e.periodo}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <section id="experiencia" class="contenedor seccion">
      <h2 class="titulo aparece"><span class="mono">02.</span> Experiencia</h2>
      <ol class="linea">
        {experiencia.map((x) => (
          <li class="aparece">
            <div class="linea-cab">
              <h3>{x.cargo} <span class="en">· {x.lugar}</span></h3>
              <span class="mono periodo">{x.periodo}</span>
            </div>
            <ul class="puntos">{x.puntos.map((p) => <li>{p}</li>)}</ul>
            <ul class="chips">{x.stack.map((s) => <li>{s}</li>)}</ul>
          </li>
        ))}
      </ol>
    </section>

    <section id="proyectos" class="contenedor seccion">
      <h2 class="titulo aparece"><span class="mono">03.</span> Proyectos</h2>
      <div class="destacados">
        {destacados.map((p) => (
          <article class="tarjeta grande aparece" style={`--acento:${p.acento}`}>
            {p.imagen ? (
              <img src={p.imagen} alt={`Captura de ${p.nombre}`} loading="lazy" />
            ) : (
              <div class="tarjeta-arte" aria-hidden="true"><span>{p.nombre}</span></div>
            )}
            <div class="tarjeta-cuerpo">
              <p class="tipo mono">{p.tipo}</p>
              <h3>{p.nombre}</h3>
              <p>{p.descripcion}</p>
              <ul class="chips">{p.stack.map((s) => <li>{s}</li>)}</ul>
              <div class="enlaces">
                {p.enlaces.map((e) => <a href={e.url} target="_blank" rel="noopener">{e.texto} ↗</a>)}
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="rejilla">
        {otros.map((p) => (
          <article class="tarjeta aparece" style={`--acento:${p.acento}`}>
            <p class="tipo mono">{p.tipo}</p>
            <h3>{p.nombre}</h3>
            <p>{p.descripcion}</p>
            <ul class="chips">{p.stack.map((s) => <li>{s}</li>)}</ul>
            <div class="enlaces">
              {p.enlaces.map((e) => <a href={e.url} target="_blank" rel="noopener">{e.texto} ↗</a>)}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="habilidades" class="contenedor seccion">
      <h2 class="titulo aparece"><span class="mono">04.</span> Habilidades</h2>
      <div class="habilidades">
        {habilidades.map((h) => (
          <div class="grupo aparece">
            <h3>{h.grupo}</h3>
            <ul class="chips">{h.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <section id="contacto" class="contenedor seccion contacto aparece">
      <h2 class="titulo"><span class="mono">05.</span> Hablemos</h2>
      <p>¿Tienes un proyecto, una vacante o una idea? Respondo rápido.</p>
      <div class="acciones">
        <a class="boton boton-principal" href={`mailto:${perfil.email}`}>{perfil.email}</a>
        <a class="boton" href={perfil.github} target="_blank" rel="noopener">GitHub</a>
      </div>
    </section>
  </main>

  <footer class="contenedor pie">
    <span>© {anio} {perfil.nombreCompleto}</span>
    <span class="mono">Hecho con Astro · {perfil.ubicacion}</span>
  </footer>
</Layout>
